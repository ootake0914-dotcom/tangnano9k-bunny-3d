        5'd14: sin_q = 12'd2675;
        5'd15: sin_q = 12'd2824;
        5'd16: sin_q = 12'd2966;
        5'd17: sin_q = 12'd3101;
        5'd18: sin_q = 12'd3228;
        5'd19: sin_q = 12'd3348;
        5'd20: sin_q = 12'd3460;
        5'd21: sin_q = 12'd3563;
        5'd22: sin_q = 12'd3658;
        5'd23: sin_q = 12'd3744;
        5'd24: sin_q = 12'd3821;
        5'd25: sin_q = 12'd3888;
        5'd26: sin_q = 12'd3947;
        5'd27: sin_q = 12'd3996;
        5'd28: sin_q = 12'd4035;
        5'd29: sin_q = 12'd4064;
        5'd30: sin_q = 12'd4084;
        5'd31: sin_q = 12'd4094;
        default: sin_q = 12'd0;
    endcase
endfunction

