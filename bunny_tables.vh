// bunny128: vert/edge ROMs in BSRAM (vert_mem.hex/edge_mem.hex);
// this file keeps sin_q + rg_rom only.
// sin quarter-wave LUT (midpoint sampled): sin((i+0.5)/32*90deg)*4095.
function [11:0] sin_q(input [4:0] i);
    case (i)
        5'd0: sin_q = 12'd100;
        5'd1: sin_q = 12'd301;
        5'd2: sin_q = 12'd501;
        5'd3: sin_q = 12'd700;
        5'd4: sin_q = 12'd897;
        5'd5: sin_q = 12'd1092;
        5'd6: sin_q = 12'd1285;
        5'd7: sin_q = 12'd1474;
        5'd8: sin_q = 12'd1659;
        5'd9: sin_q = 12'd1841;
        5'd10: sin_q = 12'd2018;
        5'd11: sin_q = 12'd2191;
        5'd12: sin_q = 12'd2358;
        5'd13: sin_q = 12'd2519;
        5'd14: sin_q = 12'd2675;
        5'd15: sin_q = 12'd2824;
        5'd16: sin_q = 12'd2966;
        5'd17: sin_q = 12'd3101;
        5'd18: sin_q = 12'd3228;
        5'd19: sin_q = 12'd3348;
        5'd20: sin_q = 12'd3460;
        5'd21: sin_q = 12'd3563;
        5'd22: sin_q = 12'd3658;
        5'd23: sin_q = 12'd3744;
        5'd24: sin_q = 12'd3821;
        5'd25: sin_q = 12'd3888;
        5'd26: sin_q = 12'd3947;
        5'd27: sin_q = 12'd3996;
        5'd28: sin_q = 12'd4035;
        5'd29: sin_q = 12'd4064;
        5'd30: sin_q = 12'd4084;
        5'd31: sin_q = 12'd4094;
        default: sin_q = 12'd0;
    endcase
endfunction

// bunny vertex region ROM: 0=ears 1=head 2=body 3=feet.
