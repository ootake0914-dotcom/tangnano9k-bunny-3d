// bunny256: vert/edge ROMs in BSRAM (vert_mem.hex/edge_mem.hex);
// this file keeps sin_q + rg_rom only.
// sin quarter-wave LUT (midpoint sampled): sin((i+0.5)/32*90deg)*4095.
function [11:0] sin_q(input [4:0] i);
    case (i)
        5'd0: sin_q = 12'd100;
        5'd1: sin_q = 12'd301;
        5'd2: sin_q = 12'd501;
        5'd3: sin_q = 12'd700;
        5'd4: sin_q = 12'd897;
        5'd5: sin_q = 12'd1092;
        5'd6: sin_q = 12'd1285;
        5'd7: sin_q = 12'd1474;
